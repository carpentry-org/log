(deftype LogRecord [level Int
                    msg String
                    file String
                    line Int])

(defmodule LogRecord
  (doc level-str
    "Returns the string representation of the log level of a LogRecord.")
  (defn level-str [r]
    (case @(level r) 5 @"TRACE" 4 @"DEBUG" 3 @"INFO" 2 @"WARN" 1 @"ERROR" @"?"))

  (doc pretty "Formats a LogRecord as a human-readable string.")
  (defn pretty [r]
    (fmt "[%s] %s:%d: %s" &(level-str r) (file r) @(line r) (msg r))))

(defmodule Log
  (def TRACE 5)
  (def DEBUG 4)
  (def INFO 3)
  (def WARN 2)
  (def ERROR 1)
  (def OFF 0)

  (private LEVEL)
  (def LEVEL OFF)

  (doc set-level "Sets the log level.")
  (defn set-level [lvl] (set! LEVEL lvl))

  (doc enabled? "Checks whether messages at level `lvl` are currently logged.")
  (defn enabled? [lvl] (<= lvl LEVEL))

  (private log-)
  (def log- (the (Fn [(Ref LogRecord)] ()) (fn [r] ())))

  (doc set-logger "Sets the logger.")
  (defn set-logger [logger] (set! log- logger))

  (hidden priv-log)
  (defn priv-log [msg lvl file line]
    (when (enabled? lvl) (log- &(LogRecord.init lvl msg @file line))))

  (defndynamic log-dyn [msg args sev]
    (list 'when
          (list 'Log.enabled? sev)
          (list 'Log.priv-log
                (cons 'fmt (cons msg args))
                sev
                (eval (list 'file msg))
                (eval (list 'line msg)))))

  (doc error
    "Logs a formatted message at ERROR level."
    "The arguments are not evaluated unless ERROR is enabled.")
  (defmacro error [msg :rest args] (Log.log-dyn msg args 'Log.ERROR))
  (doc warn
    "Logs a formatted message at WARN level."
    "The arguments are not evaluated unless WARN is enabled.")
  (defmacro warn [msg :rest args] (Log.log-dyn msg args 'Log.WARN))
  (doc info
    "Logs a formatted message at INFO level."
    "The arguments are not evaluated unless INFO is enabled.")
  (defmacro info [msg :rest args] (Log.log-dyn msg args 'Log.INFO))
  (doc debug
    "Logs a formatted message at DEBUG level."
    "The arguments are not evaluated unless DEBUG is enabled.")
  (defmacro debug [msg :rest args] (Log.log-dyn msg args 'Log.DEBUG))
  (doc trace
    "Logs a formatted message at TRACE level."
    "The arguments are not evaluated unless TRACE is enabled.")
  (defmacro trace [msg :rest args] (Log.log-dyn msg args 'Log.TRACE)))
