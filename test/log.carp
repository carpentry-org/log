(load "Test.carp")
(load "main.carp")

(use Test)

; A capturing backend so we can observe which log calls actually fire and, for
; the ones that do, what level and message the forwarded record carried.
(defmodule Capture
  (def n 0)
  (def last-level 0)
  (def last-msg @"")
  (defn reset! []
    (do
      (set! Capture.n 0)
      (set! Capture.last-level 0)
      (set! Capture.last-msg @"")))
  (defn record [r]
    (do
      (set! Capture.last-level @(LogRecord.level r))
      (set! Capture.last-msg @(LogRecord.msg r))
      (set! Capture.n (inc Capture.n)))))

(deftest test
  ; level-str maps every known severity to its name.
  (assert-equal test
    "TRACE"
    &(LogRecord.level-str &(LogRecord.init Log.TRACE @"" @"" 0))
    "level-str TRACE")
  (assert-equal test
    "DEBUG"
    &(LogRecord.level-str &(LogRecord.init Log.DEBUG @"" @"" 0))
    "level-str DEBUG")
  (assert-equal test
    "INFO"
    &(LogRecord.level-str &(LogRecord.init Log.INFO @"" @"" 0))
    "level-str INFO")
  (assert-equal test
    "WARN"
    &(LogRecord.level-str &(LogRecord.init Log.WARN @"" @"" 0))
    "level-str WARN")
  (assert-equal test
    "ERROR"
    &(LogRecord.level-str &(LogRecord.init Log.ERROR @"" @"" 0))
    "level-str ERROR")
  ; Anything outside 1..5 (including OFF) falls back to "?".
  (assert-equal test
    "?"
    &(LogRecord.level-str &(LogRecord.init Log.OFF @"" @"" 0))
    "level-str OFF -> ?")
  (assert-equal test
    "?"
    &(LogRecord.level-str &(LogRecord.init 99 @"" @"" 0))
    "level-str above range -> ?")
  (assert-equal test
    "?"
    &(LogRecord.level-str &(LogRecord.init -1 @"" @"" 0))
    "level-str below range -> ?")
  ; pretty renders "[LEVEL] file:line: msg".
  (assert-equal test
    "[INFO] app.carp:42: hello"
    &(LogRecord.pretty &(LogRecord.init Log.INFO @"hello" @"app.carp" 42))
    "pretty INFO record")
  (assert-equal test
    "[ERROR] a.carp:1: boom"
    &(LogRecord.pretty &(LogRecord.init Log.ERROR @"boom" @"a.carp" 1))
    "pretty ERROR record")
  ; Gating: priv-log only forwards records at or above the configured level,
  ; and each record it does forward carries that call's level and message.
  (do
    (Log.set-logger Capture.record)
    (Log.set-level Log.WARN)
    (Capture.reset!)
    (Log.trace "t")
    (Log.debug "d")
    (Log.info "i")
    (assert-equal test 0 Capture.n "trace/debug/info are suppressed at WARN"))
  (do (Log.warn "w") (assert-equal test 1 Capture.n "warn fires at WARN"))
  (assert-equal test Log.WARN Capture.last-level "warn forwards a WARN record")
  (assert-equal test "w" &Capture.last-msg "warn forwards its message")
  (do (Log.error "e") (assert-equal test 2 Capture.n "error fires at WARN"))
  (assert-equal test
    Log.ERROR
    Capture.last-level
    "error forwards an ERROR record")
  (assert-equal test "e" &Capture.last-msg "error forwards its message")
  (do
    (Log.set-level Log.OFF)
    (Capture.reset!)
    (Log.error "e")
    (assert-equal test 0 Capture.n "OFF suppresses even error"))
  (do
    (Log.set-level Log.TRACE)
    (Capture.reset!)
    (Log.trace "t")
    (Log.debug "d")
    (Log.info "i")
    (Log.warn "w")
    (Log.error "e")
    (assert-equal test 5 Capture.n "every level fires at TRACE"))
  ; Forwarding: with everything enabled, each macro must hand the backend a
  ; record carrying its own level and the fully formatted message (fmt
  ; arguments included), not just bump the counter.
  (do
    (Log.set-level Log.TRACE)
    (Capture.reset!)
    (Log.error "boom %d" 1)
    (assert-equal test
      Log.ERROR
      Capture.last-level
      "error forwards the ERROR level"))
  (assert-equal test
    "boom 1"
    &Capture.last-msg
    "error forwards the formatted message")
  (do
    (Capture.reset!)
    (Log.warn "boom %d" 2)
    (assert-equal test
      Log.WARN
      Capture.last-level
      "warn forwards the WARN level"))
  (assert-equal test
    "boom 2"
    &Capture.last-msg
    "warn forwards the formatted message")
  (do
    (Capture.reset!)
    (Log.info "boom %d" 3)
    (assert-equal test
      Log.INFO
      Capture.last-level
      "info forwards the INFO level"))
  (assert-equal test
    "boom 3"
    &Capture.last-msg
    "info forwards the formatted message")
  (do
    (Capture.reset!)
    (Log.debug "boom %d" 4)
    (assert-equal test
      Log.DEBUG
      Capture.last-level
      "debug forwards the DEBUG level"))
  (assert-equal test
    "boom 4"
    &Capture.last-msg
    "debug forwards the formatted message")
  (do
    (Capture.reset!)
    (Log.trace "boom %d" 5)
    (assert-equal test
      Log.TRACE
      Capture.last-level
      "trace forwards the TRACE level"))
  (assert-equal test
    "boom 5"
    &Capture.last-msg
    "trace forwards the formatted message"))
