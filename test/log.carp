(load "Test.carp")
(load "main.carp")

(use Test)

; A capturing backend so we can observe which log calls actually fire.
(defmodule Capture
  (def n 0)
  (defn reset! [] (set! Capture.n 0))
  (defn record [r]
    (do (ignore (LogRecord.level r)) (set! Capture.n (inc Capture.n)))))

(deftest test
  ; level-str maps every known severity to its name.
  (assert-equal test
    "TRACE"
    &(LogRecord.level-str &(LogRecord.init Log.TRACE @"" @"" 0))
    "level-str TRACE")
  (assert-equal test
    "DEBUG"
    &(LogRecord.level-str &(LogRecord.init Log.DEBUG @"" @"" 0))
    "level-str DEBUG")
  (assert-equal test
    "INFO"
    &(LogRecord.level-str &(LogRecord.init Log.INFO @"" @"" 0))
    "level-str INFO")
  (assert-equal test
    "WARN"
    &(LogRecord.level-str &(LogRecord.init Log.WARN @"" @"" 0))
    "level-str WARN")
  (assert-equal test
    "ERROR"
    &(LogRecord.level-str &(LogRecord.init Log.ERROR @"" @"" 0))
    "level-str ERROR")
  ; Anything outside 1..5 (including OFF) falls back to "?".
  (assert-equal test
    "?"
    &(LogRecord.level-str &(LogRecord.init Log.OFF @"" @"" 0))
    "level-str OFF -> ?")
  (assert-equal test
    "?"
    &(LogRecord.level-str &(LogRecord.init 99 @"" @"" 0))
    "level-str above range -> ?")
  (assert-equal test
    "?"
    &(LogRecord.level-str &(LogRecord.init -1 @"" @"" 0))
    "level-str below range -> ?")
  ; pretty renders "[LEVEL] file:line: msg".
  (assert-equal test
    "[INFO] app.carp:42: hello"
    &(LogRecord.pretty &(LogRecord.init Log.INFO @"hello" @"app.carp" 42))
    "pretty INFO record")
  (assert-equal test
    "[ERROR] a.carp:1: boom"
    &(LogRecord.pretty &(LogRecord.init Log.ERROR @"boom" @"a.carp" 1))
    "pretty ERROR record")
  ; Gating: priv-log only forwards records at or above the configured level.
  (do
    (Log.set-logger Capture.record)
    (Log.set-level Log.WARN)
    (Capture.reset!)
    (Log.trace "t")
    (Log.debug "d")
    (Log.info "i")
    (assert-equal test 0 Capture.n "trace/debug/info are suppressed at WARN"))
  (do (Log.warn "w") (assert-equal test 1 Capture.n "warn fires at WARN"))
  (do (Log.error "e") (assert-equal test 2 Capture.n "error fires at WARN"))
  (do
    (Log.set-level Log.OFF)
    (Capture.reset!)
    (Log.error "e")
    (assert-equal test 0 Capture.n "OFF suppresses even error"))
  (do
    (Log.set-level Log.TRACE)
    (Capture.reset!)
    (Log.trace "t")
    (Log.debug "d")
    (Log.info "i")
    (Log.warn "w")
    (Log.error "e")
    (assert-equal test 5 Capture.n "every level fires at TRACE")))
